# -----------------------------------------------------------------------------
# DOC Intelligence API - Variáveis de Ambiente de Exemplo
# -----------------------------------------------------------------------------

# Provedor de Inteligência Artificial (Opcional - a suíte de testes utiliza mocks/webmock por padrão)
# Para executar extrações reais com o modelo Grok Vision da xAI, informe sua chave:
XAI_API_KEY=your_xai_api_key_here

# Banco de Dados PostgreSQL (Padrão: localhost:5432)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis e Sidekiq (Padrão: localhost:6379)
REDIS_URL=redis://localhost:6379/1

# Porta do Servidor Web Rails
PORT=3000
